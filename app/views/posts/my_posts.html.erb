<%= link_to "Voltar para mural", posts_path%>
<%= link_to "Postar", new_post_path	%>
<hr/>
<% @posts.each do |post| %>
  <div class="post">
    <h2><%= post.title %></h2>
    <p><%= post.description %></p>
    <%= link_to 'Editar', edit_post_path(post) %>
    <%= link_to "Deletar", post, data: { turbo_method: :delete} %>
    <small>Posted on <%= post.created_at.strftime("%B %d, %Y") %></small>
  </div>
  <hr/>
<% end %>